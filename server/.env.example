# Copy to the repository root as .env (or server/.env) and fill in the keys you have.

# Active provider at start-up: azure | gemini (switchable at runtime from the UI)
LLM_PROVIDER=azure
LLM_TIMEOUT_SECONDS=45

# Azure AI Foundry (direct API key, OpenAI-compatible v1 endpoint)
AZURE_FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=gpt-5.4

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Simulation tuning
AGENT_STEP_DELAY_SECONDS=0.8
TELEMETRY_INTERVAL_SECONDS=6
WEATHER_API_ENABLED=true
PORTAL_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# E-mail to traveler contacts (SMTP). Gmail: smtp.gmail.com, port 587, and a 16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords). Port 465 uses implicit SSL.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<sender>@gmail.com
SMTP_PASSWORD=
SMTP_FROM=<sender>@gmail.com
SMTP_FROM_NAME=Meridian Airways Disruption Desk

# SMS to traveler contacts: twilio | fast2sms (leave empty to disable)
SMS_PROVIDER=
# Twilio: trial accounts can only text numbers verified in the Twilio console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Fast2SMS (India, Quick SMS route, needs a recharged wallet)
FAST2SMS_API_KEY=

# Real-time flights (AviationStack, free plan is metered: responses are cached in SQLite)
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_AIRPORT=MAA
AVIATIONSTACK_CACHE_SECONDS=900

# Crowd monitor: how often the browser sends a camera frame to the vision model
CROWD_FRAME_INTERVAL_SECONDS=20

# SQLite file (default server/data/arro.db, /tmp/arro.db on Vercel)
# DATABASE_PATH=
