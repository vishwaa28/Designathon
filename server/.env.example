# Copy to the repository root as .env (or server/.env) and fill in the keys you have.

# Active provider at start-up: azure | gemini (switchable at runtime from the UI)
LLM_PROVIDER=azure
LLM_TIMEOUT_SECONDS=45

# Azure AI Foundry (direct API key, OpenAI-compatible v1 endpoint)
AZURE_FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=gpt-5.4

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Simulation tuning
AGENT_STEP_DELAY_SECONDS=0.8
TELEMETRY_INTERVAL_SECONDS=6
WEATHER_API_ENABLED=true
PORTAL_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
